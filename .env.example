# Supabase (from your project settings)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin console
# Random 32+ char string; salts the HMAC email fingerprints. Rotating it
# invalidates existing fingerprints in account_directory.
ADMIN_EMAIL_SALT=change-me-to-a-long-random-string

# Secret path of the ops console, served at /ops/<path>.
# Defaults to "admin/admin" (i.e. /ops/admin/admin) when unset.
# Set a long random value in production.
ADMIN_CONSOLE_PATH=admin/admin
